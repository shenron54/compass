# COMPASS_HOST may list several names separated by ", " (comma and space) (the sanmejora subdomain and an
# sslip.io name that works before DNS exists); Caddy gets a certificate for each.
{$COMPASS_HOST} {
  encode gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    -Server
  }
  reverse_proxy web:8000
}
