# Copy to .env on the droplet (chmod 600). Never commit .env.
# Caddy reads it from deploy/.env
COMPASS_HOST=compass.sanmejora.com
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
COMPASS_TZ=Asia/Hong_Kong

IB_HOST=ib-gateway
# 4003 live, 4004 paper (socat ports inside the gateway image)
IB_PORT=4003
IB_CLIENT_ID=7
# optional when the login has one account
IB_ACCOUNT=

# IBKR Reporting > Flex Queries > Flex Web Service
FLEX_TOKEN=
FLEX_QUERY_ID=

# optional; the keyless CSV download is the fallback
FRED_API_KEY=

# use a key separate from other projects
DEEPSEEK_API_KEY=
COMPASS_FAST_MODEL=deepseek-flash
COMPASS_DEEP_MODEL=deepseek-v4-pro
LLM_MONTHLY_CAP_USD=5
