# Copy to .env on the droplet (chmod 600). Never commit .env.
COMPASS_HOST=compass.sanmejora.com
SESSION_SECRET=            # python -c "import secrets; print(secrets.token_urlsafe(32))"
COMPASS_TZ=Asia/Hong_Kong

IB_HOST=ib-gateway
IB_PORT=4003               # 4003 live, 4004 paper (socat ports inside the gateway image)
IB_CLIENT_ID=7
IB_ACCOUNT=                # optional when the login has one account

FLEX_TOKEN=                # IBKR Reporting > Flex Queries > Flex Web Service
FLEX_QUERY_ID=

FRED_API_KEY=              # optional; the keyless CSV download is the fallback

DEEPSEEK_API_KEY=          # use a key separate from other projects
COMPASS_FAST_MODEL=deepseek-flash
COMPASS_DEEP_MODEL=deepseek-v4-pro
LLM_MONTHLY_CAP_USD=5
